{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "The response schema for notifications sent when a tax invoice issuance eligibility status changes.",
  "$ref": "#/definitions/Notification",
  "definitions": {
    "Notification": {
      "type": "object",
      "required": [
        "notificationVersion",
        "notificationType",
        "payloadVersion",
        "eventTime",
        "payload",
        "notificationMetadata"
      ],
      "properties": {
        "notificationVersion": {
          "type": "string",
          "description": "The version for this notification type."
        },
        "notificationType": {
          "type": "string",
          "description": "The notification type.",
          "enum": [
            "TAX_INVOICE_ISSUANCE_ELIGIBILITY_STATUS_CHANGE"
          ]
        },
        "payloadVersion": {
          "type": "string",
          "description": "The version for this payload."
        },
        "eventTime": {
          "type": "string",
          "description": "The date and time when the notification event occurred, in ISO 8601 format."
        },
        "notificationMetadata": {
          "type": "object",
          "description": "The notification's metadata, including the publish time and the application, subscription, and notification event identifiers.",
          "$ref": "#/definitions/NotificationMetadata"
        },
        "payload": {
          "type": "object",
          "description": "Event details about the change to eligibility status.",
          "$ref": "#/definitions/Payload"
        }
      }
    },
    "NotificationMetadata": {
      "type": "object",
      "required": [
        "applicationId",
        "subscriptionId",
        "publishTime",
        "notificationId"
      ],
      "properties": {
        "applicationId": {
          "type": "string",
          "description": "The application identifier."
        },
        "subscriptionId": {
          "type": "string",
          "description": "The subscription identifier."
        },
        "publishTime": {
          "type": "string",
          "description": "The date and time when the notification was published, in ISO 8601 format."
        },
        "notificationId": {
          "type": "string",
          "description": "The notification identifier."
        }
      }
    },
    "Payload": {
      "type": "object",
      "required": [
        "marketplaceId",
        "operation",
        "status"
      ],
      "properties": {
        "marketplaceId": {
          "type": "string",
          "description": "The identifier for the store where the invoice issuance eligibility status applies."
        },
        "operation": {
          "type": "string",
          "description": "The invoice issuance operation available to the seller.",
          "enum": [
            "inbound",
            "outbound-fba-offers",
            "c-returns",
            "removals"
          ]
        },
        "status": {
          "type": "string",
          "description": "The status of the seller invoice issuance operation.",
          "enum": [
            "BLOCKED",
            "ALLOWED"
          ]
        },
        "message": {
          "type": "array",
          "minItems": 1,
          "description": "An optional message to describe why the operation is blocked.",
          "items": {
            "type": "object",
            "required": [
              "locale",
              "text"
            ],
            "properties": {
              "locale": {
                "type": "string",
                "enum": [
                  "en-US",
                  "pt-BR",
                  "es-MX"
                ],
                "description": "The language locale identifier in POSIX-style format."
              },
              "text": {
                "type": "string",
                "description": "The localized message text for the specified locale."
              }
            }
          },
          "contains": {
            "type": "object",
            "properties": {
              "locale": {
                "const": "en-US"
              }
            },
            "required": [
              "locale"
            ]
          }
        }
      }
    }
  }
}