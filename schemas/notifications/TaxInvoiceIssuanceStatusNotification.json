{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "The notification response schema for tax invoice issuance status notifications.",
  "$ref": "#/definitions/Notification",
  "definitions": {
    "Notification": {
      "type": "object",
      "required": [
        "notificationVersion",
        "notificationType",
        "payloadVersion",
        "eventTime",
        "payload",
        "notificationMetadata"
      ],
      "properties": {
        "notificationVersion": {
          "type": "string",
          "description": "The notification version."
        },
        "notificationType": {
          "type": "string",
          "description": "The notification type.",
          "enum": ["TAX_INVOICE_ISSUANCE_STATUS"]
        },
        "payloadVersion": {
          "type": "string",
          "description": "The payload version of the notification."
        },
        "eventTime": {
          "type": "string",
          "description": "The time the notification was sent."
        },
        "notificationMetadata": {
          "type": "object",
          "description": "The notification's metadata.",
          "$ref": "#/definitions/NotificationMetadata"
        },
        "payload": {
          "type": "object",
          "description": "The payload containing invoice issuance status details.",
          "$ref": "#/definitions/Payload"
        }
      }
    },
    "NotificationMetadata": {
      "type": "object",
      "required": [
        "applicationId",
        "subscriptionId",
        "publishTime",
        "notificationId"
      ],
      "properties": {
        "applicationId": {
          "type": "string",
          "description": "The application identifier."
        },
        "subscriptionId": {
          "type": "string",
          "description": "The subscription identifier."
        },
        "publishTime": {
          "type": "string",
          "description": "The time the notification was published."
        },
        "notificationId": {
          "type": "string",
          "description": "The notification identifier."
        }
      }
    },
    "Payload": {
      "type": "object",
      "required": [
        "marketplaceId",
        "invoiceId",
        "date",
        "status"
      ],
      "properties": {
        "marketplaceId": {
          "type": "string",
          "description": "The identifier for the Amazon store where the invoice was issued."
        },
        "invoiceId": {
          "type": "string",
          "description": "The invoice identifier used by an external party, typically the government agency that authorized the invoice."
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "The date and time the invoice was issued. Values are in ISO 8601 date-time format."
        },
        "orderId": {
          "type": "string",
          "description": "The order identifier associated with the invoice."
        },
        "status": {
          "type": "string",
          "description": "The status of the tax invoice issuance.",
          "enum": ["SUCCESS", "ERROR"]
        },
        "error": {
          "type": "object",
          "description": "Error details when the invoice issuance fails. Only present for error statuses.",
          "required": ["errorCode", "govResponse"],
          "properties": {
            "errorCode": {
              "type": "string",
              "description": "The error code indicating the type of failure."
            },
            "govResponse": {
              "type": "string",
              "description": "The response message from the government agency."
            }
          }
        }
      }
    }
  }
}
